# ── Database (Supabase Postgres, or any Postgres with pgvector) ─────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── LLM provider — set at least ONE of these ────────────────────────────────
# An inexpensive model is fine; quality is not being assessed.
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTERAPIKEY=
# Optional second accounts, tried before the first (see app/services/rag.py)
GROQ_API_KEY_2=
GEMINI_API_KEY_2=
# Optional self-hosted OpenAI-compatible server (vLLM etc.) — no key needed
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# ── Object storage for original PDF/DOCX files (viewer + re-download) ──────
# Any S3-compatible endpoint (Cloudflare R2, AWS S3, MinIO, ...).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_JURISDICTION_SPECIFIC_ENDPOINT=
R2_BUCKET_NAME=user-documents-prod

# ── Celery / background ingestion ───────────────────────────────────────────
CLOUDAMQP_URL=amqp://guest:guest@localhost//

# ── Auth (optional — falls back to a single dev user if unset) ─────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ── Optional: CRAG web-search fallback, observability ───────────────────────
TAVILY_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
